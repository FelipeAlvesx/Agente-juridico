# ──────────────────────────────────────────────────
# Lumina Agent — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env.
# ──────────────────────────────────────────────────

# ─── Anthropic (Claude) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (Whisper — transcrição de áudio, opcional) ───
# Deixe em branco para desabilitar transcrição de áudios.
OPENAI_API_KEY=

# Modelo Claude. Precedência: CLAUDE_MODEL (aqui) > campo "model" no tenant YAML > default.
# Demo usa Sonnet (definido em tenants/juris.yaml) p/ máxima fluidez.
# Descomente para forçar Haiku em produção (economia), sem mexer no YAML:
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Evolution API (WhatsApp) ─────────────────────
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE=juris-demo

# Evolution vista do host (8080 e de outro projeto). Dentro da rede docker o agente
# usa http://evolution:8080, definido no compose.
EVOLUTION_URL=http://localhost:8081

# URL do agente que a Evolution vai chamar com mensagens recebidas.
# Dev local com ngrok: https://xxxx.ngrok-free.app
# Produção: https://seudominio.com
AGENT_WEBHOOK_URL=http://agent:3000

# ─── Google Calendar ──────────────────────────────
# Caminho para o arquivo de credenciais service account / OAuth
GOOGLE_CREDENTIALS_PATH=./credentials/google_credentials.json
GOOGLE_CALENDAR_ID=seu-calendario@gmail.com

# Modo demo: gera slots simulados plausíveis sem necessidade de credenciais Google.
# Defina como true para rodar a demo sem Google Calendar configurado.
DEMO_CALENDAR=true

# Seed de dados: popula o banco com leads/agendamentos/conversas realistas na primeira subida.
# Desabilite em produção com dados reais.
DEMO_SEED=true

# ─── Dashboard ────────────────────────────────────
# URL do agente vista pelo browser (não pelo container).
# Entra no bundle em build time: mudou aqui, precisa `docker compose build dashboard`.
VITE_API_URL=http://localhost:3100
